#!/usr/bin/lua

local nixio = require "nixio"
local json = require "luci.jsonc"
local libdir = os.getenv("SMS2TELEGRAM_LIBDIR") or "/usr/lib/sms2telegram"
local core = dofile(libdir .. "/core.lua")
local serial = dofile(libdir .. "/serial.lua")
local at = dofile(libdir .. "/at.lua")
local vuart = dofile(libdir .. "/vuart.lua")
local delivery = dofile(libdir .. "/delivery.lua")
local status_module = dofile(libdir .. "/status.lua")
local worker_module = dofile(libdir .. "/worker.lua")
local update_offset_path = os.getenv("SMS2TELEGRAM_UPDATE_OFFSET_PATH") or
  "/etc/sms2telegram/telegram_update_offset"
local service_version = "2.0.0"
local started_at = os.time()

pcall(nixio.openlog, "sms2telegram")

local function log(level, component, message)
  nixio.syslog(level, "[" .. component .. "] " .. message)
end

local function trim(value)
  if type(value) ~= "string" then return "" end
  return value:match("^%s*(.-)%s*$")
end

local function uci_value(key)
  local pipe = io.popen("uci -q get sms2telegram.main." .. key)
  if not pipe then return "" end
  local value = pipe:read("*a")
  pipe:close()
  return trim(value)
end

local function interval(value)
  local number = tonumber(value)
  if not number or number % 1 ~= 0 or number < 1 or number > 3600 then return nil end
  return number
end

local function load_config()
  local config = {
    device = uci_value("device"),
    sms_device = uci_value("sms_device"),
    bot_token = uci_value("bot_token"),
    chat_id = uci_value("chat_id"),
    allowed_wan_device = uci_value("allowed_wan_device"),
    poll_interval = interval(uci_value("poll_interval")),
    retry_initial = interval(uci_value("retry_initial")),
    retry_max = interval(uci_value("retry_max")),
    telegram_limit = 4096
  }
  if config.sms_device == "" or config.sms_device == config.device or
      not config.poll_interval or not config.retry_initial or not config.retry_max or
      config.retry_initial > config.retry_max then return nil end
  return config
end

local function route_output()
  local status, output = delivery._run("ip -4 route get 1.1.1.1")
  if status ~= 0 and status ~= true then return "" end
  return output or ""
end

local function close_transport(transport)
  if transport and transport.close then transport:close() end
end

local function decode_json(line)
  return json.parse(line)
end

local status_bot, status_bot_id
local function ensure_status_bot(config)
  if os.getenv("SMS2TELEGRAM_STATUS_DISABLED") == "1" then return nil end
  local offset, bot_id = status_module.offset_path(update_offset_path, config.bot_token)
  if not offset then return nil end
  if status_bot and status_bot_id == bot_id then return status_bot end
  local store = status_module.OffsetStore.new(offset)
  if not store then return nil end
  status_bot = status_module.Bot.new({
    delivery = delivery,
    core = core,
    route = route_output,
    exec = delivery._run,
    sender = delivery.Sender.new({}, { pid = nixio.getpid() }),
    offset_store = store
  }, { pid = nixio.getpid() })
  status_bot_id = status_bot and bot_id or nil
  return status_bot
end

local receiver, at_client
local signal_rssi, signal_ber, registration_status
local vuart_ready = false
local last_event = "等待 Air780EPV 事件"
local last_event_at, last_event_ok

local function mark_event(message, ok)
  last_event, last_event_ok = message, ok
  last_event_at = os.date("%Y-%m-%d %H:%M:%S")
end

local function poll_status(config)
  local bot = ensure_status_bot(config)
  if not bot then return end
  local route_device = core.route_device(route_output())
  bot:poll(config, {
    version = service_version,
    uptime_seconds = os.time() - started_at,
    sms_connected = receiver ~= nil,
    sms_ready = vuart_ready,
    sms_device = config.sms_device,
    sms_device_available = nixio.fs.stat(config.sms_device) ~= nil,
    modem_connected = at_client ~= nil,
    device = config.device,
    device_available = config.device ~= "" and nixio.fs.stat(config.device) ~= nil,
    route_device = route_device,
    allowed_device = config.allowed_wan_device,
    signal_rssi = signal_rssi,
    signal_ber = signal_ber,
    registration_status = registration_status,
    last_scan = last_event,
    last_scan_at = last_event_at,
    last_scan_ok = last_event_ok
  })
end

local function refresh_at(config)
  if config.device == "" then return end
  if not at_client then
    local transport = serial.open(config.device, 115200, { drain = true })
    if not transport then return end
    local client = at.Client.new(transport)
    if not client:initialize() then close_transport(transport); return end
    at_client = client
  end
  local rssi, ber = at_client:signal_quality()
  local registered = at_client:registration_status()
  if not rssi or registered == nil then
    close_transport(at_client.transport)
    at_client, signal_rssi, signal_ber, registration_status = nil, nil, nil, nil
    return
  end
  signal_rssi, signal_ber, registration_status = rssi, ber, registered
end

local function run(config)
  local worker = worker_module.new({
    core = core,
    delivery = delivery,
    sender = delivery.Sender.new({}, { pid = nixio.getpid() }),
    route = route_output
  }, config)
  -- ponytail: retry queue is in memory; add a tiny spool file only if crash-safe delivery is required.
  local reconnect_delay, reconnect_after = nil, 0
  local send_delay, send_after = nil, 0
  local status_after, diagnostics_after = 0, 0

  while true do
    local now = os.time()
    if now >= status_after then
      poll_status(config)
      status_after = now + config.poll_interval
    end
    if now >= diagnostics_after then
      refresh_at(config)
      diagnostics_after = now + 60
    end

    if not receiver and now >= reconnect_after then
      local transport = serial.open(config.sms_device, 115200)
      if transport then
        receiver = transport
        reconnect_delay, reconnect_after = nil, 0
        vuart_ready = false
        log("info", "sms-uart", "connected: " .. config.sms_device)
      else
        reconnect_delay = core.next_backoff(
          reconnect_delay, config.retry_initial, config.retry_max)
        reconnect_after = now + reconnect_delay
        log("warning", "sms-uart", "reconnecting in " .. reconnect_delay .. "s")
      end
    end

    if receiver then
      local line, read_err = receiver:next_line(1000)
      if read_err then
        log("warning", "sms-uart", "disconnected: " .. tostring(read_err))
        close_transport(receiver)
        receiver, vuart_ready = nil, false
        reconnect_delay = core.next_backoff(
          reconnect_delay, config.retry_initial, config.retry_max)
        reconnect_after = os.time() + reconnect_delay
        mark_event("串口断开，等待重连", false)
      elseif line then
        local message, parse_err = vuart.decode_line(line, decode_json)
        if message == false then
          -- Empty line: valid framing noise, nothing to do.
        elseif not message then
          log("warning", "sms-uart", "invalid message: " .. tostring(parse_err))
          mark_event("收到非法 VUART 数据", false)
        elseif message.type == "ready" then
          vuart_ready = true
          log("info", "sms-uart", "Air780EPV ready")
          mark_event("Air780EPV 已就绪", true)
        else
          local queued = worker:enqueue(message)
          if queued then
            log("info", "sms", "received from " .. message.number)
            mark_event("收到短信，等待转发", true)
          else
            log("info", "sms", "duplicate ignored")
          end
        end
      end
    else
      nixio.nanosleep(1)
    end

    now = os.time()
    if worker:pending_count() > 0 and now >= send_after then
      local sent, category, detail, message = worker:process_next()
      if sent then
        if message then
          log("info", "sms", "forwarded to Telegram")
          mark_event("短信已转发到 Telegram", true)
        end
        send_delay, send_after = nil, 0
      elseif category == "message" then
        log("warning", "sms", "invalid event dropped: " .. tostring(detail))
        mark_event("无效短信事件已忽略", false)
      else
        send_delay = core.next_backoff(send_delay, config.retry_initial, config.retry_max)
        send_after = now + send_delay
        log("err", "sms", tostring(category) .. " retry=" .. send_delay)
        mark_event("短信转发失败，等待重试", false)
      end
    end
  end
end

while true do
  local config = load_config()
  if config and delivery.validate_credentials(config.bot_token, config.chat_id) then
    run(config)
  end
  log("err", "sms2telegram", "invalid configuration")
  nixio.nanosleep(1)
end
